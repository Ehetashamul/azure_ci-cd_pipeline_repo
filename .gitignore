# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files
*.tfplan
*.binary

# Infracost cache files
pricing.gob
manifest.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
